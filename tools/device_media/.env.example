# Controller: camera index and microphone input. Leave MIC_INPUT_DEVICE blank
# to use the default recording device.
CAMERA_INDEX=0
MIC_INPUT_DEVICE=
JPEG_QUALITY=55

# Remote host: select the playback side of a virtual audio cable.
# Windows example: CABLE Input (VB-Audio Virtual Cable)
# macOS example: BlackHole 2ch
AUDIO_OUTPUT_DEVICE=

# Optional exact virtual camera name, if more than one is installed.
VIRTUAL_CAMERA_DEVICE=
